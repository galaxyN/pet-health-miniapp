/* 页面容器 */
.container {
  padding: 15px;
  box-sizing: border-box;
  height: 100vh;
  background-color: #f8f8f8;
}

/* 搜索栏样式 */
.search-bar {
  display: flex;
  align-items: center;
  background-color: #ffff;
  border-radius: 20px;
  padding: 10px 15px;
  margin-top: 10px;
  margin-bottom: 20px;
}

.search-bar input {
  flex: 1;
  font-size: 14px;
  color: #666;
}

.search-bar image {
  width: 20px;
  height: 20px;
}

/* 医院卡片样式 */
.organization-card {
  display: flex;
  padding: 30rpx 48rpx;
  position: relative;
  background-color: #fff;
  border-radius: 10px;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.organization-icon {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  margin-right: 12px;
}

.organization-info {
  flex: 1;
  padding: 20rpx 0;
}

.organization-name {
  font-size: 15px;
  color: #333;
  margin-bottom: 5px;
}

.rating {
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.rating image {
  width: 15px;
  height: 15px;
  margin-right: 2px;
}

.rating-text {
  font-size: 12px;
  color: #999;
  margin-left: 5px;
}

.appointment-btn {
  position: absolute;
  background-color: #323232;
  color: #fff;
  font-size: 14px;
  padding: 0 40rpx;
  border-radius: 10px;
  bottom: 16rpx;
  right: 40rpx;
}