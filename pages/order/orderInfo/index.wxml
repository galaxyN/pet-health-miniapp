<view class="container">
    <view class="order">
        <view class="image-box">
            <image src="{{order.productImage}}" />
        </view>
        <view class="order-info">{{order.productName}}</view>
        <view class="right-info" wx:if="{{mode === 1}}">
            <view class="price">¥{{order.totalPrice}}</view>
            <view class="count">x{{order.quantity}}</view>
        </view>  
    </view>
    <view class="order-detail" wx:if="{{mode === 1}}">
        <view class="order-info address">
            <view class="title">地址</view>
            <view class="content">
                {{order.address.receiverName}} {{order.address.receiverPhone}}
                {{order.address.province}} {{order.address.city}} {{order.address.district}} {{order.address.detailedAddress}}
            </view>
        </view>
        <view class="order-info orderNo">
            <view class="title">订单编号</view>
            <view class="content">{{order.orderNo}}</view>
        </view>
        <view class="order-info time">
            <view class="title">下单时间</view>
            <view class="content">{{order.createdAt}}</view>
        </view>
    </view>
    <view class="order-detail" wx:else>
        <view class="order-info time">
            <view class="title">预约时间</view>
            <view class="content">{{order.time1}}</view>
        </view>
        <view class="order-info orderNo">
            <view class="title">订单编号</view>
            <view class="content">{{order.orderNo}}</view>
        </view>
        <view class="order-info time">
            <view class="title">下单时间</view>
            <view class="content">{{order.createdAt}}</view>
        </view>
    </view>
</view>