<!-- 分层购物车 -->
<view class="order-list">
  <view class="order" wx:for="{{orderList}}" bindtap="toOrderDetail">
    <block wx:for-item="order" wx:for="{{item.items}}" wx:key="id"> 
      <view class="image-box">
        <image src="{{order.productImage}}" />
      </view>
      <view class="order-info">{{order.productName}}</view>
    </block>
    <view class="icon">
      <t-icon name="chevron-right" color="#666" size="48rpx" />
    </view>  
  </view>
</view>
<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
