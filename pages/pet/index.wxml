<view class="pet-container">
    <!-- 顶部导航栏 -->
    <view class="header">
        <view class="operation-btn">
            <image src="/images/add-icon.png" bindtap="addPet" />
        </view>
    </view>
    <!-- 主要内容区 -->
    <view class="content">
        <!-- 宠物信息卡片 -->
        <view class="pet-card-box" wx:for="{{petList}}">
            <view class="pet-card">
                <image class="pet-avatar" src="{{item.image}}" mode="aspectFill"></image>
                <view class="pet-info">
                    <view class="pet-name">{{item.name}}</view>
                    <view class="pet-meta">
                        <text>{{item.desc}}</text>
                        <text>{{item.weight}}kg · {{item.age}}岁</text>
                    </view>
                </view>
                <t-icon name="more" color="#171717" size="48rpx" data-index="{{index}}" bindtap="showMore" />
            </view>
            <view class="pet-card-footer" wx:if="{{item.showBtn}}">
                <view class="btn-box">
                    <t-button variant="outline" bindtap="editPet">编辑</t-button>
                </view>
                <view class="btn-box">
                    <t-button variant="outline">删除</t-button>
                </view>
            </view>
        </view>
    </view>
</view>