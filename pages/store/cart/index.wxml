<view class="cart-page">
  <!-- 商品列表区域 -->
  <view class="goods-list">
    <view class="goods-item" wx:for="{{cartList}}" wx:key="id">
		  <view class="goods-image">
        <image src="{{item.product.mainImage}}" mode="aspectFit" />
      </view>
      <view class="goods-info">
        <view class="goods-introduce">
          <view class="goods-name">{{item.product.name}}</view>
          <view class="goods-price">￥{{item.product.price}}</view>
        </view>
        <view class="operation">
          <view class="quantity-control">
            <view class="btn" bindtap="decreaseQuantity" data-id="{{item.id}}">-</view>
            <text>{{item.quantity}}</text>
            <view class="btn" bindtap="increaseQuantity" data-id="{{item.id}}">+</view>
          </view>
          <view class="delete-btn" bindtap="deleteItem" data-id="{{item.id}}">
            <t-icon name="delete" color="#8F8F8F" size="42rpx" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 结算区域 -->
  <view class="checkout-area">
    <view class="total-info">
        <view class="total">
            <text>总计：￥{{totalPrice}}</text>
        </view>
        <view class="num" v-if="cartList.length > 0">{{cartList.length}}件物品</view>
    </view>
    <view>
        <t-button t-class="checkout-btn" size="large" bindtap="checkout">结算</t-button>
    </view>    
  </view>
</view>