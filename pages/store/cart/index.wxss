.cart-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.goods-list {
  flex: 1;
  overflow-y: auto;
  padding: 15px;
}

.goods-item {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
  height: 200rpx;
  background: #fff;
  box-sizing: border-box;
  border-radius: 20rpx;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
.goods-image{
  height: 100%;
}
.goods-image image{
  width: 192rpx;
  height: 100%;
  border-top-left-radius: 20rpx;
  border-bottom-left-radius: 20rpx;
}

.goods-info{
  padding: 30rpx 20rpx;
  box-sizing: border-box;
}

.goods-info .goods-introduce{
  display: flex;
  justify-content: space-between;
}

.goods-introduce .goods-name{
  width: 60%;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #171717;
}

.goods-introduce .goods-price{
  font-weight: 600;
  font-size: 32rpx;
  color: #323232;
}

.operation{
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.quantity-control {
  display: flex;
  align-items: center;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  border-radius: 40rpx;
  border: 1px solid #f7f7f7;
  background: #F3F3F3;
}
.quantity-control text{
  background: #fff;
  height: 60rpx;
  width: 60rpx;
}
.quantity-control .btn {
  width: 40rpx;
  text-align: center;
}

.quantity-control text {
  margin: 0 10px;
  min-width: 20px;
  text-align: center;
}

.delete-btn {
  width: 24px;
  height: 24px;
  padding: 0;
  background: transparent;
  border: none;
}

.delete-btn image {
  width: 100%;
  height: 100%;
}

.checkout-area {
    display: flex;
    padding: 30rpx;
    background: #fff;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40rpx;
}

.total {
  margin-bottom: 15px;
  font-size: 32rpx;
  font-weight: 600;
}
.num{
    color: #8F8F8F;
    font-size: 28rpx;
}

.checkout-btn {
    width: 320rpx;
    height: 112rpx;
    line-height: 112rpx;
    --td-button-default-color: #fff;
    --td-button-default-bg-color: #323232;
    --td-button-default-border-color: #323232;
    --td-button-border-radius: 20rpx;
}