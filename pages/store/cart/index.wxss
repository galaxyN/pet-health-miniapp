.cart-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.goods-list {
  flex: 1;
  overflow-y: auto;
  padding: 15px;
}

.goods-item {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}
.goods-image{
    margin-right: 15rpx;
}
.goods-image image{
    width: 192rpx;
    height: 192rpx;
    border-top-left-radius: 20rpx;
    border-bottom-left-radius: 20rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
  margin: 0 10px;
}

.quantity-control button {
  width: 30px;
  height: 30px;
  line-height: 30px;
  text-align: center;
  border: 1px solid #eee;
  background: #f7f7f7;
}

.quantity-control text {
  margin: 0 10px;
  min-width: 20px;
  text-align: center;
}

.delete-btn {
  width: 24px;
  height: 24px;
  padding: 0;
  background: transparent;
  border: none;
}

.delete-btn image {
  width: 100%;
  height: 100%;
}

.checkout-area {
    display: flex;
    padding: 30rpx;
    background: #fff;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 40rpx;
}

.total {
  margin-bottom: 15px;
  font-size: 32rpx;
  font-weight: 600;
}
.num{
    color: #8F8F8F;
    font-size: 28rpx;
}

.checkout-btn {
    width: 320rpx;
    height: 112rpx;
    line-height: 112rpx;
    --td-button-default-color: #fff;
    --td-button-default-bg-color: #323232;
    --td-button-default-border-color: #323232;
    --td-button-border-radius: 20rpx;
}