.custom-capsule {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #3232324D;
  border-radius: 50%;
  height: 75rpx;
  width: 75rpx;
}
.custom-image {
  height: 50rpx;
  width: 50rpx;
}
/* 页面容器 */
.market-container {
    display: flex;
    flex-direction: column;
    background-color: #f7f7f7;
}

/* 搜索栏 */
.search-bar {
    padding: 15px;
    display: flex;
    align-items: center;
}

.search-input {
    display: flex;
    flex-grow: 1;
    align-items: center;
    background: white;
    border-radius: 20px;
    padding: 8px 15px;
}

.search-input icon {
    margin-right: 8px;
}

.search-input input {
    flex: 1;
    font-size: 14px;
}
.filter-icon{
    margin-left: 20rpx;
    width: 90rpx;
    height: 90rpx;
}

/* 分类导航 */
.category-nav {
    white-space: nowrap;
    padding: 10px 15px;
    background: white;
    border-bottom: 1px solid #eee;
}

.category-item {
    display: inline-block;
    padding: 5px 15px;
    margin-right: 10px;
    font-size: 14px;
    border-radius: 15px;
    background: #f7f7f7;
    color: #666;
}

.category-item.active {
    background: #4a90e2;
    color: white;
}

.product-recommend{
    color: #171717;
    margin-left: 30rpx;
    margin-top: 10rpx;
    font-weight: 600;
}

/* 商品列表 */
.product-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30rpx;
    padding: 24rpx 30rpx;
    overflow-y: auto;
}

.product-item {
    background: white;
    border-radius: 16rpx;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.product-image {
    width: 100%;
    height: 160px;
    object-fit: cover;
    border-top-left-radius: 16rpx;
    border-top-right-radius: 16rpx;
}

.product-info {
    padding: 10px;
}

.product-name {
    font-size: 14px;
    margin-bottom: 5px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.product-introduce{
    display: flex;
    justify-content: space-between;
}

.product-price {
    font-size: 16px;
    font-weight: bold;
    color: #ff4d4f;
    margin-bottom: 3px;
}

.product-sales {
    font-size: 12px;
    color: #999;
}

/* 底部导航栏 */
.tab-bar {
    display: flex;
    background: white;
    border-top: 1px solid #eee;
    padding: 5px 0;
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 8px 0;
}

.tab-item image {
    width: 24px;
    height: 24px;
    margin-bottom: 3px;
}

.tab-item text {
    display: block;
    font-size: 12px;
    color: #999;
}

.tab-item.active text {
    color: #4a90e2;
}