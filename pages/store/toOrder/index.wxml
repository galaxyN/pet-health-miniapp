<view class="container">
  <!-- 地址部分 -->
  <view class="address-section" bindtap="editAddress">
    <view class="address-title">
      <text>地址</text>
      <view class="edit-btn">编辑</view>
    </view>
    <view class="address-info">
      <text class="name">{{address.name}}</text>
      <text class="phone">{{address.phone}}</text>
      <text class="address">{{address.detail}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="goods-list">
    <view class="goods-title">物品</view>
    <block wx:for="{{goodsList}}" wx:key="index">
      <view class="goods-item">
        <text class="goods-name">{{item.name}}</text>
        <text class="goods-price">¥{{item.price}}</text>
      </view>
    </block>
  </view>

  <!-- 运费 -->
  <view class="freight">
    <text>运费</text>
    <text class="price">¥{{freight}}</text>
  </view>

  <!-- 总计 -->
  <view class="total">
    <text>总计</text>
    <text class="price">¥{{totalPrice}}</text>
  </view>

  <!-- 支付方式 -->
  <view class="payment-method">
    <text>{{paymentMethod}}</text>
    <view class="checked-icon">✓</view>
  </view>

  <!-- 结算按钮 -->
  <view class="submit-btn" bindtap="submitOrder">结算</view>
</view>