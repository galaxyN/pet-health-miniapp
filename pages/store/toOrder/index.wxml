<view class="container">
  <!-- 地址部分 -->
  <view class="address-section" bindtap="selectAddress">
    <view class="address-title">
      <text>地址</text>
      <view class="edit-btn">编辑</view>
    </view>
    <view class="address-info">
      <text class="name">{{address.name}}</text>
      <text class="phone">{{address.phone}}</text>
      <text class="address">{{address.detail}}</text>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="goods-list">
    <view class="goods-title">物品</view>
    <block wx:for="{{orderItems}}" wx:key="spuId">
      <view class="goods-item">
        <text class="goods-name">{{item.goodsName}}</text>
        <text class="goods-price">￥{{item.payPrice}}</text>
      </view>
    </block>
  </view>

  <!-- 运费 -->
  <view class="freight">
    <text>运费</text>
    <text class="price">￥{{freight}}</text>
  </view>

  <!-- 优惠券 -->
  <view class="freight" wx:if="{{couponAmount > 0}}">
    <text>优惠券</text>
    <text class="price">-￥{{couponAmount}}</text>
  </view>

  <!-- 活动优惠 -->
  <view class="freight" wx:if="{{discountAmount > 0}}">
    <text>活动优惠</text>
    <text class="price">-￥{{discountAmount}}</text>
  </view>

  <!-- 总计 -->
  <view class="total">
    <text>总计</text>
    <text class="price">￥{{finalAmount}}</text>
  </view>

  <!-- 支付方式 -->
  <view class="payment-method">
    <text>微信支付</text>
    <view class="checked-icon">✓</view>
  </view>

  <!-- 结算按钮 -->
  <view class="submit-btn" bindtap="submitOrder">结算</view>
</view>