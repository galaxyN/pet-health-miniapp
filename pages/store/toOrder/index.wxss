.container {
  background-color: #ffffff;
  padding: 20rpx;
}

/* 地址部分样式 */
.address-section {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.address-section .address-title{
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
 .address-title text{
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.address-info {
  flex: 1;
}

.name, .phone {
  margin-right: 20rpx;
  font-size: 28rpx;
}

.address {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666;
}

.edit-btn {
  color: #1989fa;
  font-size: 26rpx;
}

/* 商品列表样式 */
.goods-list {
  padding: 20rpx;
}
.goods-title{
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.goods-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
}

.goods-price {
  color: #171717;
  font-size: 28rpx;
}

/* 运费和总计样式 */
.freight, .total {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
}
.freight {
  border-bottom: 1rpx solid #f5f5f5;
}

.total {
  font-weight: bold;
}

.price {
  color: #171717;
}

/* 支付方式样式 */
.payment-method {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.checked-icon {
  color: #ff6a00;
  font-weight: bold;
}

/* 结算按钮样式 */
.submit-btn {
  margin-top: 40rpx;
  background-color: #000;
  color: #fff;
  text-align: center;
  padding: 25rpx 0;
  border-radius: 50rpx;
  font-size: 32rpx;
}