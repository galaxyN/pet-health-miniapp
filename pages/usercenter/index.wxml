<view class="user">
  <view class="user-head">
    <image src="http://117.72.219.186:8080/image/cat-1.jpeg" bindtap="showUser"/>
  </view>
  <view class="user-info">
    <view class="user-info-item">
      <text class="label">用户名</text>
      <view class="value">{{ user.nickname }}</view>
    </view>
    <view class="user-info-item">
      <text class="label">电话</text>
      <view class="value">{{ user.phone }}</view>
    </view>
    <view class="user-info-item">
      <text class="label">收货地址</text>
      <view class="value">{{ user.address }}</view>
    </view>
  </view>
</view>
<t-dialog
  visible="{{showLogin}}"
  title="未登录，请先登录"
  confirm-btn="{{ confirmBtn }}"
  cancel-btn="取消"
  bind:confirm="confirmAction"
  bind:cancel="closeDialog"
/>
