.user{
  padding: 20rpx;
  background: #f8f8f8;
  height: 100vh;
  box-sizing: border-box;
}

.user-head{
  margin: 20rpx 0;
  display: flex;
  justify-content: center;
}
.user-head image{
  width: 128px;
  height: 128px;
  border-radius: 50%;
}

.user-info{
  width: 95%;
  margin: 40rpx auto;
}

.user-info-item{
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 40rpx;
  margin-bottom: 40rpx;
}
.user-info-item .label{
  font-size: 13px;
}
.user-info-item .value{
  font-size: 15px;
  margin-top: 10rpx;
  font-weight: 600;
}
