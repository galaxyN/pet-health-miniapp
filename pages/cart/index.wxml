<!-- 分层购物车 -->
<view class="order-list">
  <view class="order" wx:for="{{orderList}}" bindtap="toOrderDetail">
    <view class="image-box">
      <image src="{{item.image}}" />
    </view>
    <view class="order-info">{{item.name}}</view>
    <view class="icon">
      <t-icon name="chevron-right" color="#666" size="48rpx" />
    </view>  
  </view>
</view>
<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
