<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input placeholder="搜索" />
    <image src="../resource/hospital/search.png" />
  </view>

  <!-- 医院列表 -->
  <view class="hospital-list">
    <block wx:for="{{hospitals}}" wx:key="id">
      <view class="hospital-card">
        <image class="hospital-icon" src="{{item.icon}}" />
        <view class="hospital-info">
          <text class="hospital-name">{{item.name}}</text>
          <view class="rating">
            <block wx:for="{{item.stars}}" wx:key="*this">
              <image 
                src="{{item === 1 ? '../resource/hospital/star-full.png' : (item === 0.5 ? '../resource/hospital/star-half.png' : '/../resource/hospital/star.png')}}" 
              />
            </block>
            <text class="rating-text">{{item.rating}}分</text>
          </view>
        </view>
        <button 
          class="appointment-btn" 
          bindtap="handleAppointment"
          data-id="{{item.id}}"
        >
          预约
        </button>
      </view>
    </block>
  </view>
</view>