<view class="container">
  <!-- 头部信息 -->
  <view class="header">
    <view class="back-btn" bindtap="navigateBack">
      <image src="/images/back.png" />
    </view>
    <view class="hospital-card">
      <image class="hospital-icon" src="{{hospital.image}}" />
      <view class="hospital-info">
        <text class="name">{{hospital.name}}</text>
        <view class="rating">
          <block wx:for="{{[1,2,3,4,5]}}" wx:key="*this">
            <image src="{{item <= hospital.rating ? '../resource/hospital/star-full.png' : (item - 0.5 <= hospital.rating ? '../resource/hospital/star-half.png' : '../resource/hospital/star.png')}}" />
          </block>
          <text class="score">{{hospital.rating}}分</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系信息 -->
  <view class="contact-info">
    <view class="item">
      <view>电话</view>
      <text>{{hospital.phone}}</text>
    </view>
    <view class="item">
      <view>地址</view>
      <text>{{hospital.address}}</text>
    </view>
  </view>

  <!-- 评论区域 -->
  <view class="comments">
    <view class="head">
      <view class="title">评论</view>
      <text class="more">全部</text>
    </view>  
    <block wx:for="{{hospital.comments}}" wx:key="username">
      <view class="comment-item">
        <view class="user-info">
          <text class="username">{{item.username}}</text>
          <text class="date">{{item.date}}</text>
        </view>
        <view class="content">
          {{item.content}}
        </view>
      </view>
    </block>
  </view>

  <!-- 预约按钮 -->
  <view class="footer">
    <button class="appointment-btn" bindtap="handleAppointment">预约</button>
  </view>
</view>