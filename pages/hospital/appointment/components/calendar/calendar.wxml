<view class="calendar">
    <view class="header">
        <image src="../../../resource/Circle Left.png" bindtap="prevMonth" />
        <text>{{year}}年{{month}}月</text>
        <image src="../../../resource/Circle Right.png" bindtap="nextMonth" />
    </view>
    <view class="weekdays">
        <text>一</text>
        <text>二</text>
        <text>三</text>
        <text>四</text>
        <text>五</text>
        <text>六</text>
        <text>日</text>
    </view>
    <view class="days">
        <block wx:for="{{dateArray}}" wx:key="index">
            <view class="day {{item.className}}" data-day="{{item.day}}" bindtap="selectDay">{{item.day}}</view>
        </block>
    </view>
</view>
