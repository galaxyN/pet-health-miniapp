<view class="calendar">
    <view class="header">
        <button bind:tap="prevMonth">上个月</button>
        <text>{{year}}年{{month}}月</text>
        <button bind:tap="nextMonth">下个月</button>
    </view>
    <view class="weekdays">
        <text>一</text>
        <text>二</text>
        <text>三</text>
        <text>四</text>
        <text>五</text>
        <text>六</text>
        <text>日</text>
    </view>
    <view class="days">
        <block wx:for="{{dateArray}}" wx:key="index">
            <view class="day {{item.className}}" data-day="{{item.day}}" bindtap="selectDay">{{item.day}}</view>
        </block>
    </view>
</view>
