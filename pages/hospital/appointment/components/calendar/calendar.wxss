.calendar {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #fff;
    width: 90%;
    margin: 0 auto;
    border-radius: 15px;
}

.header {
    font-size: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    padding: 0 10px;
    margin: 10px 0;
}
.header image{
    width: 52rpx;
    height: 52rpx;
}

.weekdays {
    display: flex;
    width: 100%;
    margin-bottom: 10px;
    justify-content: space-around;
}
.weekdays text{
    width: 90rpx;
    text-align: center;
}

.days {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
}

.days .day-box{
    width: 14.28%;
    text-align: center;
}

.day {
    width: 80rpx;
    height: 80rpx;
    line-height: 80rpx;
    text-align: center;
    box-sizing: border-box;
}

.inactive{
    color: #999;
}

.selected {
    background-color: #007aff;
    color: white;
    border-radius: 50%;
}
