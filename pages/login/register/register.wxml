<!--pages/login/register/register.wxml-->
<view class="container">
  <view class="logo-container">
    <image class="logo" src="/images/logo-2.png" mode="aspectFit" />
    <text class="title">注册</text>
  </view>
  <form class="form">
    <input class="input" type="text" placeholder="用户名" name="username" />
    <input class="input" type="text" placeholder="邮箱" name="email" />
    <input class="input" type="password" placeholder="密码" name="password" />
    <input class="input" type="password" placeholder="确认密码" name="confirmPassword" />
    <button class="register-button" form-type="submit">注册</button>
  </form>
  <view class="login-link">
    <text>已有账号？</text><text bindtap="navigateToLogin">立即登录</text>
  </view>
</view>