<view class="container">
    <view class="logo-container">
        <button class="avatar-wrapper" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image class="avatar" src="{{avatarUrl}}"></image>
        </button>
    </view>
    <form class="form">
        <input class="input" type="nickname" placeholder="用户名" name="nickName" model:value="{{nickName}}" bind:change="onInputChange" />
        <button class="login-button" bind:tap="onLogin">登录</button>
    </form>
    <!-- <view class="register">
        <text>没有账户？</text>
        <text class="register-link" bind:tap="onRegister">注册</text>
    </view> -->
</view>