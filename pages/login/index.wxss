.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
  background-color: #fff;
  height: 100vh;
}
.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}
.logo {
    margin-top: 144rpx;
    width: 128rpx;
    height: 128rpx;
    border-radius: 30rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}
.title {
    font-family: Archivo;
    font-size: 36rpx;
    font-weight: bold;
    color: #171717;
}
.form {
    width: 100%;
    margin-top: 144rpx;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    padding: 0 20rpx;
}
.input {
    height: 60rpx;
    margin-bottom: 20rpx;
    padding: 20rpx;
    border-radius: 20rpx;
    border: 1rpx solid #ddd;
    background-color: #fff;
    font-size: 24rpx;
    box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}
.forget-password {
  text-align: right;
  margin-bottom: 30rpx;
  color: #409eff;
  font-size: 22rpx;
}
.login-button {
    width: 520rpx;
    height: 98rpx;
    line-height: 98rpx;
    border-radius: 30rpx;
    background-color: #333;
    color: #fff;
    font-size: 26rpx;
    font-weight: bold;
    text-align: center;
    border: none;
}
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
  width: 100%;
}
.line {
  flex: 1;
  height: 1rpx;
  background-color: #ddd;
}
.or-text {
  margin: 0 20rpx;
  color: #999;
  font-size: 22rpx;
}
.social-login {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 40rpx;
}
.social-button {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #f0f4f8;
  display: flex;
  justify-content: center;
  align-items: center;
}
.social-button.apple {
  background-color: #d9e9ff;
}
.social-button.google {
  background-color: #fce8e6;
}
.register {
    position: fixed;
    bottom: 80rpx;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    justify-content: center;
    font-size: 22rpx;
    color: #999;
}
.register-link {
    color: #409eff;
    margin-left: 10rpx;
}