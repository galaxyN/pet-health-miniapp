.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
  padding: 20px;
}

.greeting {
  font-size: 20px;
  margin: 20px 0;
  color: #000000;
  display: flex;
  flex-direction: column;
}

.greeting text:nth-child(2){
  margin-top: 12rpx;
  font-size: 28rpx;
}

.pet-card {
  display: flex;
  flex-direction: column;
  background-color: #f5f5f5;
  border-radius: 12px;
  padding: 28rpx 40rpx 46rpx 40rpx;
  margin-bottom: 20px;
  position: relative;
}
.pet-card .card-head{
  margin-bottom: 22rpx;
}

.pet-card .card-main{
  display: flex;
  align-items: center;
  background-color: #f5f5f5;
  border-radius: 12px;
}

.pet-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12px;
  margin-right: 15px;
}

.pet-info {
  flex: 1;
}

.pet-name {
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 5px;
}

.pet-detail {
  font-size: 14px;
  color: #666666;
}

.add-icon {
  position: absolute;
  right: 15px;
  top: 15px;
  font-size: 24px;
  color: #000000;
}

.function-modules {
  display: flex;
  justify-content: space-between;
  margin-top: 96rpx;
}

.function-modules image{
  width: 324rpx;
  height: 404rpx;
}


